{
  "name": "@acoderacom/shopify-admin-mcp",
  "version": "1.0.0",
  "description": "MCP server providing full access to Shopify's Admin GraphQL API with schema introspection",
  "type": "module",
  "bin": {
    "shopify-admin-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "graphql": "^16.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "mcp",
    "shopify",
    "graphql",
    "admin-api",
    "model-context-protocol",
    "metaobjects",
    "metafields"
  ],
  "author": "acoderacom (https://github.com/acoderacom)",
  "contributors": [
    "Colby McHenry (https://github.com/colbymchenry)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acoderacom/shopify-admin-mcp.git"
  },
  "homepage": "https://github.com/acoderacom/shopify-admin-mcp#readme",
  "bugs": {
    "url": "https://github.com/acoderacom/shopify-admin-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
