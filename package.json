{
  "name": "@acodera/shopify-admin-mcp",
  "version": "1.3.0",
  "description": "MCP server providing full access to Shopify's Admin GraphQL API with schema introspection",
  "type": "module",
  "bin": {
    "shopify-admin-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "graphql": "^17.0.2",
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "mcp",
    "shopify",
    "graphql",
    "admin-api",
    "model-context-protocol",
    "metaobjects",
    "metafields"
  ],
  "author": "acoderacom (https://github.com/acoderacom)",
  "contributors": [
    "Colby McHenry (https://github.com/colbymchenry)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acoderacom/shopify-admin-mcp.git"
  },
  "homepage": "https://github.com/acoderacom/shopify-admin-mcp#readme",
  "bugs": {
    "url": "https://github.com/acoderacom/shopify-admin-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
